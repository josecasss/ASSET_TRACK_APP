@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName:       'Asset',
  typeNamePlural: 'Assets',
  title:          { type: #STANDARD, value: 'AssetTagNumber' },
  description:    { type: #STANDARD, value: 'AssetDescription' }
}

annotate entity ZC_ASSETFC with
{
  @UI.facet: [
    { id: 'AssetMasterData', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE,
      label: 'Asset Master Data',  position: 10 },
    { id: 'History',         purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      label: 'Status History',     position: 20, targetElement: '_AssetHistory' },
    { id: 'Attachments',     purpose: #STANDARD, type: #LINEITEM_REFERENCE,
      label: 'Attachments',        position: 30, targetElement: '_Attachment' }
  ]

  @UI.hidden: true
  UUID;

  @UI.lineItem: [
    { position: 10, importance: #HIGH, label: 'Asset Tag',
      criticality: 'StatusCriticality', criticalityRepresentation: #WITH_ICON },
    { type: #FOR_ACTION_GROUP, actionGroupId: 'ChangeStatusGroup', label: 'Change Status', position: 60 },
    { type: #FOR_ACTION, dataAction: 'flagAsDamage',       label: 'Flag as Damage',        actionGroupId: 'ChangeStatusGroup' },
    { type: #FOR_ACTION, dataAction: 'notMatchCostCenter', label: 'Not Match Cost Center', actionGroupId: 'ChangeStatusGroup' },
    { type: #FOR_ACTION, dataAction: 'proposeWriteOff',    label: 'Propose Write Off',     actionGroupId: 'ChangeStatusGroup' },
    { type: #FOR_ACTION, dataAction: 'flagAsSold',         label: 'Flag as Sold',          actionGroupId: 'ChangeStatusGroup' },
    { type: #FOR_ACTION, dataAction: 'resetToNormal',      label: 'Reset to Normal',       actionGroupId: 'ChangeStatusGroup' }
  ]
  @UI.identification: [
    { position: 10 },
    { type: #FOR_ACTION_GROUP, actionGroupId: 'ChangeStatusGroupOP', label: 'Change Status', position: 60 },
    { type: #FOR_ACTION, dataAction: 'flagAsDamage',       label: 'Flag as Damage',        actionGroupId: 'ChangeStatusGroupOP' },
    { type: #FOR_ACTION, dataAction: 'notMatchCostCenter', label: 'Not Match Cost Center', actionGroupId: 'ChangeStatusGroupOP' },
    { type: #FOR_ACTION, dataAction: 'proposeWriteOff',    label: 'Propose Write Off',     actionGroupId: 'ChangeStatusGroupOP' },
    { type: #FOR_ACTION, dataAction: 'flagAsSold',         label: 'Flag as Sold',          actionGroupId: 'ChangeStatusGroupOP' },
    { type: #FOR_ACTION, dataAction: 'resetToNormal',      label: 'Reset to Normal',       actionGroupId: 'ChangeStatusGroupOP' }
  ]
  @UI.selectionField: [{ position: 10 }]
  AssetTagNumber;

  @UI.lineItem:       [{ position: 20, importance: #HIGH, label: 'Description' }]
  @UI.identification: [{ position: 20, label: 'Description' }]
  AssetDescription;

  @UI.lineItem:       [{ position: 30, importance: #MEDIUM, label: 'Company Code' }]
  @UI.identification: [{ position: 30, label: 'Company Code' }]
  @UI.selectionField: [{ position: 20 }]
  @Consumption.valueHelpDefinition: [{ entity:                      { name: 'ZC_ASSET_CCVH', element: 'CompanyCode' },
                                       presentationVariantQualifier: 'HIERARCHY',
                                       label:                        'Company Code' }]
  CompanyCode;

  @UI.hidden: true
  CompanyName;

  @UI.lineItem:       [{ position: 40, importance: #LOW, label: 'Main Asset No.' }]
  @UI.identification: [{ position: 40, label: 'Main Asset No.' }]
  MainAssetNumber;

  @UI.lineItem:       [{ position: 50, importance: #LOW, label: 'Sub Number' }]
  @UI.identification: [{ position: 50, label: 'Sub Number' }]
  AssetSubNumber;

  @UI.lineItem: [{ position: 60, importance: #HIGH, label: 'Status',
                   criticality: 'StatusCriticality', criticalityRepresentation: #WITH_ICON }]
  @UI.identification: [{ position: 60, label: 'Current Status',
                          criticality: 'StatusCriticality' }]
  @UI.selectionField: [{ position: 30 }]
  Status;

  @UI.hidden: true
  AssetStatusDescription;

  @UI.hidden: true
  StatusCriticality;

  @UI.lineItem:       [{ position: 70, importance: #LOW, label: 'Creation Date' }]
  @UI.identification: [{ position: 70, label: 'Creation Date' }]
  CreationDate;

  @UI.identification: [{ position: 80, label: 'Changed Date' }]
  ChangedDate;

  @UI.hidden: true LocalCreatedBy;
  @UI.hidden: true LocalCreatedAt;
  @UI.hidden: true LocalLastChangedBy;
  @UI.hidden: true LocalLastChangedAt;
  @UI.hidden: true LastChangedAt;
}