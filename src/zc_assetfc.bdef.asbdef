projection implementation in class ZBP_C_ASSETFC unique;
strict ( 2 );
extensible;
use draft;
use side effects;

define behavior for ZC_ASSETFC alias Asset
extensible
use etag
{
  use create;
  use update;
  use delete;

  use action flagAsDamage;
  use action notMatchCostCenter;
  use action proposeWriteOff;
  use action flagAsSold;
  use action resetToNormal;
  use action transferAsset;

  use action uploadAssets;
  use action downloadTemplate;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _AssetHistory { with draft; }
  use association _Attachment   { create; with draft; }
}

define behavior for ZC_ASSETHISTORYFC alias AssetHistory
extensible
use etag
{
  use association _Asset { with draft; }
}

define behavior for ZC_AssetAttachmentTP alias AssetAttachment
{
  use update;
  use delete;
  use association _Asset { with draft; }
}