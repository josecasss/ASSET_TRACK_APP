managed implementation in class ZBP_R_ASSETFC unique;
strict ( 2 );
with draft;
extensible;

define behavior for ZR_ASSETFC alias Asset
persistent table zassetfc
extensible
draft table zasset_dfc
lock master total etag LastChangedAt
etag master LocalLastChangedAt
authorization master ( global )
{
  create ( authorization : global );
  update;
  delete;

  association _AssetHistory { create; with draft; }
  association _Attachment   { create; with draft; }

  field ( numbering : managed, readonly ) UUID;
  field ( readonly ) AssetTagNumber, Status, LastChangedAt, LocalCreatedAt, LocalCreatedBy, LocalLastChangedAt, LocalLastChangedBy;
  field ( mandatory ) AssetDescription, CompanyCode, MainAssetNumber, AssetSubNumber, CostCenter, InventoryNumber;

  action ( features : instance, authorization : update ) flagAsDamage        result [1] $self;
  action ( features : instance, authorization : update ) notMatchCostCenter  result [1] $self;
  action ( features : instance, authorization : update ) proposeWriteOff     result [1] $self;
  action ( features : instance, authorization : update ) flagAsSold          result [1] $self;
  action ( features : instance, authorization : update ) resetToNormal       result [1] $self;
  action ( features : instance, authorization : update ) transferAsset parameter ZA_ASSET_TRANSFER_PARAM result [1] $self;

  static action uploadAssets   parameter ZAE_ASSET_UPLOAD_PARAM;
  static action downloadTemplate;

  determination setInitialStatus on modify { create; }
  determination setCreationDate  on modify { create; }
  determination setChangedDate   on modify { field AssetDescription; field CompanyCode; field MainAssetNumber; field AssetSubNumber; field InventoryNumber; field CostCenter; field Status; }

  validation validateCompanyCode      on save { create; field CompanyCode; field MainAssetNumber; field AssetSubNumber; }
  validation validateAssetDescription on save { create; field AssetDescription; }
  validation validateAssetTag         on save { create; field AssetTagNumber; field CostCenter; field InventoryNumber; }

  side effects
  {
    field CompanyCode affects field CostCenter, field InventoryNumber;
    field CostCenter  affects field InventoryNumber;

    action flagAsDamage       affects entity _AssetHistory;
    action notMatchCostCenter affects entity _AssetHistory;
    action proposeWriteOff    affects entity _AssetHistory;
    action flagAsSold         affects entity _AssetHistory;
    action resetToNormal      affects entity _AssetHistory;
    action transferAsset      affects entity _AssetHistory;
  }

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;

  draft determine action Prepare
  {
    validation validateCompanyCode;
    validation validateAssetDescription;
    validation validateAssetTag;
  }

  mapping for zassetfc corresponding extensible
  {
    UUID             = uuid;
    AssetTagNumber   = asset_tag_number;
    AssetDescription = asset_description;
    CompanyCode      = company_code;
    MainAssetNumber  = main_asset_number;
    AssetSubNumber   = asset_sub_number;
    InventoryNumber  = inventory_number;
    CostCenter       = cost_center;
    Status           = status;
    CreationDate     = creation_date;
    ChangedDate      = changed_date;
    LocalCreatedBy     = local_created_by;
    LocalCreatedAt     = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}

define behavior for ZR_ASSETHISTORYFC alias AssetHistory
persistent table zassethistoryfc
extensible
draft table zassthistory_dfc
etag dependent by _Asset
lock dependent by _Asset
authorization dependent by _Asset
{
  field ( readonly ) UUID, ParentUUID, HisID, PreviousStatus, NewStatus, Text000;
  field ( numbering : managed ) UUID;
  mapping for zassethistoryfc corresponding extensible
  {
    UUID           = uuid;
    ParentUUID     = parent_uuid;
    HisID          = his_id;
    PreviousStatus = previous_status;
    NewStatus      = new_status;
    Text000        = text000;
  }
  association _Asset { with draft; }
}

define behavior for ZI_AssetAttachmentTP alias AssetAttachment
  persistent table zasset_attachm
  draft table zasset_attachmd
  lock dependent by _Asset
  authorization dependent by _Asset
  etag dependent by _Asset
{
  field ( readonly, numbering : managed ) AttachUUID;
  field ( readonly ) UUID, CreatedBy, CreatedAt, LastChangedBy, LastChangedAt;
  update;
  delete;
  mapping for zasset_attachm
  {
    AttachUUID    = attach_uuid;
    UUID          = parent_uuid;
    FileContent   = file_content;
    MimeType      = mime_type;
    FileName      = file_name;
    FileSize      = file_size;
    CreatedBy     = local_created_by;
    CreatedAt     = local_created_at;
    LastChangedBy = local_last_changed_by;
    LastChangedAt = local_last_changed_at;
  }
  association _Asset { with draft; }
}