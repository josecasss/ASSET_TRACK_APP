@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
  typeName:       'History Entry',
  typeNamePlural: 'History Entries',
  title:          { type: #STANDARD, value: 'HisID' },
  description:    { type: #STANDARD, value: 'Text000' }
}
annotate view ZC_ASSETHISTORYFC with
{
  @UI.facet: [
    {
      id:       'HistoryDetails',
      purpose:  #STANDARD,
      type:     #IDENTIFICATION_REFERENCE,
      label:    'Status Change Details',
      position: 10
    }
  ]

  @UI.hidden: true
  UUID;

  @UI.hidden: true
  ParentUUID;

  @UI.lineItem:       [{ position: 10, importance: #HIGH,   label: 'History No.' }]
  @UI.identification: [{ position: 10, label: 'History No.' }]
  HisID;

  @UI.lineItem:       [{ position: 20, importance: #HIGH,   label: 'Previous Status' }]
  @UI.identification: [{ position: 20, label: 'Previous Status' }]
  PreviousStatus;

  @UI.lineItem:       [{ position: 30, importance: #HIGH,   label: 'New Status' }]
  @UI.identification: [{ position: 30, label: 'New Status' }]
  NewStatus;

  @UI.lineItem:       [{ position: 40, importance: #MEDIUM, label: 'Comments' }]
  @UI.identification: [{ position: 40, label: 'Comments' }]
  Text000;

  @UI.hidden: true
  _BaseEntity;
}